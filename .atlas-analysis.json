  "keyFeatures": [
    "RAPID framework enforcement — exactly one Decide owner, mandatory Recommend/Perform roles per document",
    "Immutable ledger — audit-proof finalization via atomic transaction",
    "Role-based access control — 6 system roles with 16 permissions enforced at API and frontend layers",
    "Decision workflow state machine — draft → submitted → approved → finalized → execution_complete",
    "TOTP two-factor authentication",
    "Fathom Video transcript pipeline — paste meeting notes, AI extracts RAPID roles and decisions",
    "Notion sync — approved documents auto-push to your Notion database",
    "Linear integration — approved decisions create Linear issues automatically",
    "CSV and PDF export for ledger and decision documents",
    "Full-text search and filters across all decisions",
    "Multi-tenant organisation support with invite flow",
    "15+ audit action types across the full document lifecycle"
  ],
