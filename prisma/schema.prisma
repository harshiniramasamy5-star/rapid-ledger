generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String          @id @default(cuid())
  name      String
  domain    String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  documents RapidDocument[]
  auditLogs AuditLog[]
  invites   Invite[]
}

model Invite {
  id        String       @id @default(cuid())
  email     String
  orgId     String
  token     String       @unique @default(cuid())
  role      UserRole     @default(viewer)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id])

  @@index([token])
  @@index([email])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String
  role            UserRole         @default(viewer)
  department      String?
  isActive        Boolean          @default(true)
  failedLogins    Int              @default(0)
  lockedUntil     DateTime?
  orgId           String?
  totpSecret      String?
  totpEnabled     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvals       Approval[]
  auditLogs       AuditLog[]
  evidence        Evidence[]
  documents       RapidDocument[]  @relation("CreatedBy")
  comments        Comment[]
  refreshTokens   RefreshToken[]   @relation("UserRefreshTokens")
  roleAssignments RoleAssignment[]
  org             Organization?    @relation(fields: [orgId], references: [id])
}

model RapidDocument {
  id                     String           @id @default(cuid())
  documentCode           String
  version                Int              @default(1)
  title                  String
  decisionSummary        String
  riskLevel              RiskLevel        @default(low)
  status                 DocumentStatus   @default(draft)
  documentType           DocumentType     @default(RAPID)
  visibility             Visibility       @default(PRIVATE)
  parentDocumentId       String?
  complianceImpact       Boolean          @default(false)
  businessContext        String?
  problemStatement       String?
  proposedDecision       String?
  department             String?
  createdById            String
  orgId                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  alternativesConsidered String?
  deadline               DateTime?
  slaBreached            Boolean          @default(false)
  submittedAt            DateTime?
  finalizedAt            DateTime?
  recommendationNotes    String?          @default("")
  inputNotes             String?          @default("")
  mediaUrl               String?
  transcriptUrl          String?
  transcriptContent      String?
  notionPageId           String?
  syncedAt               DateTime?
  syncStatus             SyncStatus?
  approvals              Approval[]
  auditLogs              AuditLog[]
  evidence               Evidence[]
  ledgerEntries          LedgerEntry[]
  createdBy              User             @relation("CreatedBy", fields: [createdById], references: [id])
  parentDocument         RapidDocument?   @relation("Transcripts", fields: [parentDocumentId], references: [id])
  transcripts            RapidDocument[]  @relation("Transcripts")
  org                    Organization?    @relation(fields: [orgId], references: [id])
  roleAssignments        RoleAssignment[]
  comments               Comment[]

  @@unique([documentCode, version])
  @@index([status])
  @@index([createdById])
  @@index([deadline])
}

model RoleAssignment {
  id         String        @id @default(cuid())
  documentId String
  roleType   RoleType
  userId     String
  createdAt  DateTime      @default(now())
  document   RapidDocument @relation(fields: [documentId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
}

model Evidence {
  id          String        @id @default(cuid())
  documentId  String
  type        String
  title       String
  urlOrPath   String
  description String?
  uploadedBy  String
  createdAt   DateTime      @default(now())
  document    RapidDocument @relation(fields: [documentId], references: [id])
  uploader    User          @relation(fields: [uploadedBy], references: [id])
}

model Approval {
  id         String        @id @default(cuid())
  documentId String
  approverId String
  decision   String        @default("pending")
  comment    String?
  createdAt  DateTime      @default(now())
  approver   User          @relation(fields: [approverId], references: [id])
  document   RapidDocument @relation(fields: [documentId], references: [id])
}

model LedgerEntry {
  id           String        @id @default(cuid())
  documentId   String
  finalizedAt  DateTime      @default(now())
  summary      String?
  createdAt    DateTime      @default(now())
  documentCode String
  version      Int
  title        String
  finalizedBy  String
  document     RapidDocument @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id         String         @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  details    String?
  documentId String?
  orgId      String?
  createdAt  DateTime       @default(now())
  document   RapidDocument? @relation(fields: [documentId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  org        Organization?  @relation(fields: [orgId], references: [id])

  @@index([documentId])
  @@index([userId, createdAt])
  @@index([orgId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String        @id @default(cuid())
  content    String
  documentId String
  authorId   String
  parentId   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  document   RapidDocument @relation(fields: [documentId], references: [id])
  author     User          @relation(fields: [authorId], references: [id])
  parent     Comment?      @relation("Replies", fields: [parentId], references: [id])
  replies    Comment[]     @relation("Replies")

  @@index([documentId])
  @@index([parentId])
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum DocumentStatus {
  draft
  submitted
  awaiting_agreement
  approved
  rejected
  needs_changes
  finalized
  execution_complete
}

enum RoleType {
  recommend
  agree
  perform
  input
  decide
}

enum AuditAction {
  login
  login_failed
  document_created
  document_submitted
  document_approved
  document_rejected
  document_needs_changes
  document_finalized
  document_versioned
  role_assigned
  evidence_added
  user_created
  user_updated
  ledger_entry_created
  document_recommended
  document_input_provided
  execution_complete
  org_created
  document_type_changed
  visibility_changed
  invite_sent
  invite_accepted
  notion_synced
}

enum DocumentType {
  RAPID
  PORTAL
  TRANSCRIPT
}

enum Visibility {
  PRIVATE
  ORG
  PUBLIC
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum UserRole {
  admin
  creator
  approver
  recommender
  performer
  viewer
}
