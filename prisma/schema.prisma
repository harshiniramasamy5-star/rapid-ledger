generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String
  role            UserRole @default(viewer)
  department      String?
  isActive        Boolean          @default(true)
  failedLogins    Int              @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvals       Approval[]
  auditLogs       AuditLog[]
  evidence        Evidence[]
  documents       RapidDocument[]  @relation("CreatedBy")
  refreshTokens   RefreshToken[]   @relation("UserRefreshTokens")
  roleAssignments RoleAssignment[]
}

model RapidDocument {
  id                     String           @id @default(cuid())
  documentCode           String
  version                Int              @default(1)
  title                  String
  decisionSummary        String
  riskLevel              RiskLevel @default(low)
  status                 DocumentStatus @default(draft)
  complianceImpact       Boolean          @default(false)
  businessContext        String?
  problemStatement       String?
  proposedDecision       String?
  department             String?
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  alternativesConsidered String?
  deadline               DateTime?
  slaBreached            Boolean          @default(false)
  submittedAt            DateTime?
  finalizedAt            DateTime?
  recommendationNotes    String?          @default("")
  inputNotes             String?          @default("")
  approvals              Approval[]
  auditLogs              AuditLog[]
  evidence               Evidence[]
  ledgerEntries          LedgerEntry[]
  createdBy              User             @relation("CreatedBy", fields: [createdById], references: [id])
  roleAssignments        RoleAssignment[]

  @@unique([documentCode, version])
  @@index([status])
  @@index([createdById])
  @@index([deadline])
}

model RoleAssignment {
  id         String        @id @default(cuid())
  documentId String
  roleType   RoleType
  userId     String
  createdAt  DateTime      @default(now())
  document   RapidDocument @relation(fields: [documentId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
}

model Evidence {
  id          String        @id @default(cuid())
  documentId  String
  type        String
  title       String
  urlOrPath   String
  description String?
  uploadedBy  String
  createdAt   DateTime      @default(now())
  document    RapidDocument @relation(fields: [documentId], references: [id])
  uploader    User          @relation(fields: [uploadedBy], references: [id])
}

model Approval {
  id         String        @id @default(cuid())
  documentId String
  approverId String
  decision   String        @default("pending")
  comment    String?
  createdAt  DateTime      @default(now())
  approver   User          @relation(fields: [approverId], references: [id])
  document   RapidDocument @relation(fields: [documentId], references: [id])
}

model LedgerEntry {
  id           String        @id @default(cuid())
  documentId   String
  finalizedAt  DateTime      @default(now())
  summary      String?
  createdAt    DateTime      @default(now())
  documentCode String
  version      Int
  title        String
  finalizedBy  String
  document     RapidDocument @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id         String         @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  details    String?
  documentId String?
  createdAt  DateTime       @default(now())
  document   RapidDocument? @relation(fields: [documentId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  @@index([documentId])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
}







enum RiskLevel {
  low
  medium
  high
  critical
}

enum DocumentStatus {
  draft
  submitted
  awaiting_agreement
  approved
  rejected
  needs_changes
  finalized
  execution_complete
}

enum RoleType {
  recommend
  agree
  perform
  input
  decide
}

enum AuditAction {
  login
  login_failed
  document_created
  document_submitted
  document_approved
  document_rejected
  document_needs_changes
  document_finalized
  document_versioned
  role_assigned
  evidence_added
  user_created
  user_updated
  ledger_entry_created
  document_recommended
  document_input_provided
  execution_complete
}

enum UserRole {
  admin
  creator
  approver
  recommender
  performer
  viewer
}
