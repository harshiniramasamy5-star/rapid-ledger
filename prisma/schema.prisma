generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String
  role            String  @default("viewer")
  department      String?
  isActive        Boolean          @default(true)
  failedLogins    Int              @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvals       Approval[]
  auditLogs       AuditLog[]
  evidence        Evidence[]
  documents       RapidDocument[]  @relation("CreatedBy")
  refreshTokens   RefreshToken[]   @relation("UserRefreshTokens")
  roleAssignments RoleAssignment[]
}

model RapidDocument {
  id                     String           @id @default(cuid())
  documentCode           String
  version                Int              @default(1)
  title                  String
  decisionSummary        String
  riskLevel              String  @default("low")
  status                 String  @default("draft")
  complianceImpact       Boolean          @default(false)
  businessContext        String?
  problemStatement       String?
  proposedDecision       String?
  department             String?
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  alternativesConsidered String?
  deadline               DateTime?
  submittedAt            DateTime?
  finalizedAt            DateTime?
  recommendationNotes    String?          @default("")
  inputNotes             String?          @default("")
  approvals              Approval[]
  auditLogs              AuditLog[]
  evidence               Evidence[]
  ledgerEntries          LedgerEntry[]
  createdBy              User             @relation("CreatedBy", fields: [createdById], references: [id])
  roleAssignments        RoleAssignment[]

  @@unique([documentCode, version])
}

model RoleAssignment {
  id         String        @id @default(cuid())
  documentId String
  roleType   String
  userId     String
  createdAt  DateTime      @default(now())
  document   RapidDocument @relation(fields: [documentId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
}

model Evidence {
  id          String        @id @default(cuid())
  documentId  String
  type        String
  title       String
  urlOrPath   String
  description String?
  uploadedBy  String
  createdAt   DateTime      @default(now())
  document    RapidDocument @relation(fields: [documentId], references: [id])
  uploader    User          @relation(fields: [uploadedBy], references: [id])
}

model Approval {
  id         String        @id @default(cuid())
  documentId String
  approverId String
  decision   String        @default("pending")
  comment    String?
  createdAt  DateTime      @default(now())
  approver   User          @relation(fields: [approverId], references: [id])
  document   RapidDocument @relation(fields: [documentId], references: [id])
}

model LedgerEntry {
  id           String        @id @default(cuid())
  documentId   String
  finalizedAt  DateTime      @default(now())
  summary      String?
  createdAt    DateTime      @default(now())
  documentCode String
  version      Int
  title        String
  finalizedBy  String
  document     RapidDocument @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id         String         @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    String?
  documentId String?
  createdAt  DateTime       @default(now())
  document   RapidDocument? @relation(fields: [documentId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
}





